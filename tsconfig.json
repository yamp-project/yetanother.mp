{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "types": ["vite/client", "node"]
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
